# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public URL the app is served from (used for cookies, absolute links, CSRF).
APP_URL=http://localhost:3000
# 32+ random bytes, hex or base64. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret
# Session lifetime in hours (sliding expiration).
SESSION_TTL_HOURS=168
# Comma-separated list of mailbox addresses allowed to open /admin/diagnostics.
ADMIN_EMAILS=
# How many mailboxes one browser session may be signed in to at once (1-20).
MAX_MAILBOXES_PER_SESSION=10
# Serve the integration documentation at /docs (public, no sign-in needed).
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# How many proxies in front of the app append to X-Forwarded-For. The client IP
# (used for login throttling) is read that many entries from the right, so it
# cannot be spoofed. Nginx/Caddy/Traefik = 1, Cloudflare -> Nginx = 2.
TRUST_PROXY_HOPS=1
# Trust Cloudflare's CF-Connecting-IP header. Only enable this when the origin
# accepts connections from Cloudflare's IP ranges alone.
TRUST_CLOUDFLARE=false

# ---------------------------------------------------------------------------
# Mailcow IMAP (Dovecot)
# ---------------------------------------------------------------------------
MAIL_IMAP_HOST=mail.example.com
MAIL_IMAP_PORT=993
# true = IMAPS (implicit TLS on 993). false = plain + STARTTLS upgrade (143).
MAIL_IMAP_TLS=true
# Reject invalid / self-signed certificates. Only set to false for local testing.
MAIL_TLS_REJECT_UNAUTHORIZED=true
# Certificate name to verify for IMAP, SMTP and ManageSieve when the hosts above
# are internal names (e.g. dovecot-mailcow / postfix-mailcow on the mailcow
# Docker network). Set it to MAILCOW_HOSTNAME. Empty = verify the host name.
MAIL_TLS_SERVERNAME=

# ---------------------------------------------------------------------------
# Mailcow SMTP (Postfix submission)
# ---------------------------------------------------------------------------
MAIL_SMTP_HOST=mail.example.com
MAIL_SMTP_PORT=587
# true = implicit TLS (465). false = plain + STARTTLS (587).
MAIL_SMTP_SECURE=false
# Require STARTTLS when MAIL_SMTP_SECURE=false. Never send credentials in clear.
MAIL_SMTP_REQUIRE_TLS=true

# ---------------------------------------------------------------------------
# Mailcow ManageSieve (Dovecot) — used for per-mailbox mail forwarding
# ---------------------------------------------------------------------------
MAIL_SIEVE_ENABLED=true
# Defaults to MAIL_IMAP_HOST. Mailcow publishes ManageSieve on port 4190.
MAIL_SIEVE_HOST=
MAIL_SIEVE_PORT=4190
# Require STARTTLS before sending credentials (recommended; Mailcow supports it).
MAIL_SIEVE_REQUIRE_TLS=true
MAIL_SIEVE_TIMEOUT_SECONDS=15
# Turn the per-mailbox forwarding feature on or off for everyone.
MAIL_FORWARDING_ENABLED=true
# Maximum forwarding addresses per mailbox (1-20). Dovecot's default
# sieve_max_redirects is 4; Mailcow raises it to 100.
MAX_FORWARD_ADDRESSES=4
# Optional comma-separated allow-list of destination domains (empty = any),
# e.g. "example.com,partner.example" to stop mail leaving approved domains.
MAIL_FORWARDING_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_ATTACHMENT_SIZE_MB=50
MAX_MESSAGE_SIZE_MB=60
# Max IMAP connections per signed-in mailbox (pool size).
IMAP_POOL_SIZE=3
# Idle IMAP connections are closed after this many seconds.
IMAP_IDLE_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database for sessions, preferences, contacts and signatures.
DATABASE_PATH=./data/webmail.db
# Temporary storage for compose attachments before they are sent.
UPLOAD_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Testing only. NEVER enable in production; the server refuses to start with
# MAIL_PROVIDER=mock when NODE_ENV=production.
# ---------------------------------------------------------------------------
# MAIL_PROVIDER=imap
# ALLOW_MOCK_PROVIDER=false
